# coloring-book — environment configuration
# Copy to .env and fill in your secrets

# App
APP_ENV=development
DEBUG=true

# AI Image Generation (for text-prompt flow)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Alternative: Stability AI (Stable Diffusion)
# STABILITY_API_KEY=

# Image Processing
MAX_IMAGE_SIZE_MB=10
OUTPUT_FORMAT=png   # png or svg

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000
